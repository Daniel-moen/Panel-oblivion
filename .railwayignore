# Never upload these to Railway.
#
# .env holds live API keys — they belong in Railway's own variables, which are
# encrypted and not baked into the image.
.env

# Local virtualenv (Railway installs from requirements.txt) and caches.
.venv/
__pycache__/
*.pyc
.httpcache/

# The database lives on a mounted volume in production. Shipping the local
# copy would overwrite the deployed one on every push.
prospects.db
prospects.db-shm
prospects.db-wal
prospects.db.bak*
/prospects.html

# crawler.py job spec + progress snapshot: webapp writes them to DATA_DIR,
# which is the repo root locally.
crawl_job.json
crawl_progress.json
crawl_progress.json.tmp

.claude/
.dashboard-password.txt

# Git history — not needed in the image, and new since the repo was initialised.
.git/

# Front-end tooling: only ui/build is served; the rest is local-only.
ui/node_modules/
ui/.svelte-kit/

# The media library: zerko/ MUST ship (media.py imports it), but the state it
# writes locally must not — the deployed copy keeps its own on the volume.
# The CLI also applies .gitignore, which lists /zerko/, so re-include it here
# (this file takes precedence); the exclusions below still apply inside it.
!/zerko/
/media-data/
/files/
/zerko/.env
/zerko/_scratch/
/zerko/Zerko Files/
/zerko/*.db
/zerko/*.db-wal
/zerko/*.db-shm
/zerko/zerko.config.json
/mediamanager.db*
